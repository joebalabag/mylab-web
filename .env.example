# Copy to .env.local and fill in per-environment values.
# Vite loads .env, .env.local, .env.<mode>, .env.<mode>.local in that order.
# Every .env* file (except this one) is gitignored — put your secrets/URLs there.

# ─── API ─────────────────────────────────────────────────────────────
# Base URL of the MyLab API (include /api, no trailing slash).
# Examples:
#   VITE_API_BASE=http://127.0.0.1:3010/api                     # local dev
#   VITE_API_BASE=https://staging-api-mylab.edgetechph.net/api  # staging
#   VITE_API_BASE=https://api-mylab.edgetechph.net/api          # prod
VITE_API_BASE=

# ─── Payment instructions (Subscription page fallback) ───────────────
# Shown when a subscription plan has no per-plan payee configured.
VITE_PAY_GCASH_NAME=
VITE_PAY_GCASH_NUMBER=
VITE_PAY_BANK_NAME=
VITE_PAY_BANK_ACCOUNT=
VITE_PAY_GCASH_QR_URL=

# ─── PayPal Smart Button (Subscription page) ─────────────────────────
# Leave blank to hide the PayPal button. When set, tenants can pay
# directly in the browser; the subscription activates on capture
# (also validated server-side by the PayPal webhook for redundancy).
# Use a Sandbox client id for dev/staging and a Live id in production.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_CURRENCY=PHP
